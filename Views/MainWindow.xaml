<Window x:Class="DnDCharacterManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="D&amp;D Character Manager"
        Height="900"
        Width="1400"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PrimaryDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PrimaryMidBrush}"
                        BorderBrush="{StaticResource AccentGoldBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="16,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Dragon"
                                                  Width="28" Height="28"
                                                  Foreground="{StaticResource AccentGoldBrush}"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="D&amp;D Manager"
                                   Style="{StaticResource TitleText}"
                                   FontSize="20"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,12">
                    <StackPanel x:Name="NavMenuPanel" />
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{StaticResource PrimaryMidBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="v0.1.0 — Local build"
                                   Style="{StaticResource BodyText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Rulebook data is user-imported"
                                   Style="{StaticResource BodyText}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource SurfaceDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceMidBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PageTitleText"
                                   Style="{StaticResource HeadingText}"
                                   FontSize="22"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="Settings"
                                    Click="SettingsButton_Click">
                                <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="About"
                                    Click="AboutButton_Click"
                                    Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent" />
            </Grid>
        </Border>
    </Grid>
</Window>
