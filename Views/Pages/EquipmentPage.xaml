<Page x:Class="DnDCharacterManager.Views.Pages.EquipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Equipment" Background="Transparent">
    <Grid Margin="32">
        <Border Style="{StaticResource FantasyCard}" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="760">
            <StackPanel>
                <TextBlock Text="Equipment" Style="{StaticResource TitleText}"
                           FontSize="30" HorizontalAlignment="Center" />
                <TextBlock Text="Equipment catalogue and loadout editing will be implemented in the equipment phase."
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
