<Page x:Class="DnDCharacterManager.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Dashboard"
      Background="Transparent"
      d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Border Style="{StaticResource FantasyCard}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Welcome Back, Dungeon Master"
                                   Style="{StaticResource TitleText}"
                                   FontSize="28" />
                        <TextBlock Text="Manage your characters, prepare encounters, and roll dice."
                                   Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding NewCharacterCommand}"
                            Padding="24,12"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="New Character" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="Overview" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding StatCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GoldBorderCard}"
                                Width="220" Height="140" Margin="0,0,16,16">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                         Width="40" Height="40"
                                                         Foreground="{StaticResource AccentGoldBrush}"
                                                         HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Value}"
                                           Style="{StaticResource StatValueText}"
                                           FontSize="42" />
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource StatLabelText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Quick Actions" Style="{StaticResource HeadingText}" Margin="0,24,0,16" />
            <WrapPanel Orientation="Horizontal">
                <Button Style="{StaticResource FantasyButton}"
                        Command="{Binding ViewCharactersCommand}"
                        Width="200" Height="100" Margin="0,0,16,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" HorizontalAlignment="Center" />
                        <TextBlock Text="Characters" Style="{StaticResource SubheadingText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="View and manage" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FantasyButton}"
                        Command="{Binding NewEncounterCommand}"
                        Width="200" Height="100" Margin="0,0,16,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="DiceD20" Width="32" Height="32" HorizontalAlignment="Center" />
                        <TextBlock Text="New Encounter" Style="{StaticResource SubheadingText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Prepare combat" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FantasyButton}"
                        Command="{Binding OpenDiceRollerCommand}"
                        Width="200" Height="100" Margin="0,0,16,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="DiceMultiple" Width="32" Height="32" HorizontalAlignment="Center" />
                        <TextBlock Text="Dice Roller" Style="{StaticResource SubheadingText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Roll dice" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FantasyButton}"
                        Command="{Binding OpenEquipmentCommand}"
                        Width="200" Height="100" Margin="0,0,16,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="SwordCross" Width="32" Height="32" HorizontalAlignment="Center" />
                        <TextBlock Text="Equipment" Style="{StaticResource SubheadingText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Weapons and armor" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Border Style="{StaticResource FantasyCard}"
                    Margin="0,24,0,0"
                    Visibility="{Binding RecentCharacter, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Recent Character" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="80" Height="80" CornerRadius="8"
                                Background="{StaticResource PrimaryMidBrush}" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="48" Height="48"
                                                     Foreground="{StaticResource AccentGoldBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecentCharacter.Name}"
                                       Style="{StaticResource TitleText}" FontSize="22" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RecentCharacter.Class}" Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource AccentGoldBrush}" />
                                <TextBlock Text=" • " Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RecentCharacter.Race}" Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text=" • Level " Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RecentCharacter.Level}" Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource FantasyButton}"
                                Command="{Binding ViewCharactersCommand}"
                                Padding="16,8" VerticalAlignment="Center">View All</Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FantasyCard}"
                    Margin="0,24,0,0"
                    Visibility="{Binding RecentCharacter, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Dragon" Width="64" Height="64"
                                             Foreground="{StaticResource TextDisabledBrush}"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="No characters yet" Style="{StaticResource HeadingText}"
                               Margin="0,16,0,8" HorizontalAlignment="Center" />
                    <TextBlock Text="Create your first hero to begin your adventure"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Button Style="{StaticResource GoldButton}"
                            Command="{Binding NewCharacterCommand}"
                            Margin="0,16,0,0" Padding="32,12">Create Character</Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
