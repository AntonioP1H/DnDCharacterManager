<Page x:Class="DnDCharacterManager.Views.Pages.CharacterCreationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Create Character" Background="Transparent">
    <Grid Margin="32">
        <Border Style="{StaticResource FantasyCard}" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="760">
            <StackPanel>
                <TextBlock Text="Create Character" Style="{StaticResource TitleText}"
                           FontSize="30" HorizontalAlignment="Center" />
                <TextBlock Text="Character creation, including race and class choices, will be implemented after importing your rulebooks."
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
