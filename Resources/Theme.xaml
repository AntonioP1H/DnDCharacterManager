<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />
    <Style TargetType="Button" BasedOn="{StaticResource FantasyButton}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource FantasyTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource FantasyComboBox}" />
    <Style TargetType="ListView" BasedOn="{StaticResource FantasyListView}" />
    <Style TargetType="ListViewItem" BasedOn="{StaticResource FantasyListViewItem}" />
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource FantasyScrollViewer}" />
    <Style x:Key="DefaultCard" TargetType="Border" BasedOn="{StaticResource FantasyCard}" />
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
        <Setter Property="FontFamily" Value="Georgia" />
    </Style>
    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
    </Style>
</ResourceDictionary>
