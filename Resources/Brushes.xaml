<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fantasy / D&D palette -->
    <Color x:Key="PrimaryDark">#2D1B3D</Color>
    <Color x:Key="PrimaryMid">#4A2C6B</Color>
    <Color x:Key="PrimaryLight">#6B4E8C</Color>
    <Color x:Key="AccentGold">#D4A843</Color>
    <Color x:Key="AccentGoldLight">#E8C56D</Color>
    <Color x:Key="AccentCrimson">#8B1A1A</Color>
    <Color x:Key="SurfaceDark">#1A1A2E</Color>
    <Color x:Key="SurfaceMid">#252540</Color>
    <Color x:Key="SurfaceLight">#2D2D4A</Color>
    <Color x:Key="TextPrimary">#F0E6E0</Color>
    <Color x:Key="TextSecondary">#B8A9A0</Color>
    <Color x:Key="TextDisabled">#6B5B50</Color>
    <Color x:Key="BorderDark">#3D3D5C</Color>
    <Color x:Key="BorderGold">#D4A843</Color>
    <Color x:Key="SuccessGreen">#2E7D32</Color>
    <Color x:Key="WarningOrange">#FF8F00</Color>
    <Color x:Key="ErrorRed">#C62828</Color>

    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryMidBrush" Color="{StaticResource PrimaryMid}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}" />
    <SolidColorBrush x:Key="AccentGoldLightBrush" Color="{StaticResource AccentGoldLight}" />
    <SolidColorBrush x:Key="AccentCrimsonBrush" Color="{StaticResource AccentCrimson}" />
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
    <SolidColorBrush x:Key="SurfaceMidBrush" Color="{StaticResource SurfaceMid}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}" />
    <SolidColorBrush x:Key="BorderGoldBrush" Color="{StaticResource BorderGold}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningOrange}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorRed}" />

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryDark}" Offset="0" />
        <GradientStop Color="{StaticResource PrimaryMid}" Offset="0.5" />
        <GradientStop Color="{StaticResource PrimaryLight}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentGold}" Offset="0" />
        <GradientStop Color="{StaticResource AccentGoldLight}" Offset="0.5" />
        <GradientStop Color="{StaticResource AccentGold}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SurfaceMid}" Offset="0" />
        <GradientStop Color="{StaticResource SurfaceDark}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ParchmentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDF6E3" Offset="0" />
        <GradientStop Color="#F5E6C8" Offset="0.5" />
        <GradientStop Color="#E8D5B7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
